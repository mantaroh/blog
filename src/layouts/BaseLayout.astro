---
import '../styles/global.css';
import siteJa from '../data/site.json';
import siteEn from '../data/site.en.json';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  lang?: 'ja' | 'en';
  alternateHref?: string;
}

const {
  title,
  description,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  lang = 'ja',
  alternateHref
} = Astro.props;

const site = lang === 'en' ? siteEn : siteJa;
const finalDescription = description ?? site.description;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogType = type === 'article' ? 'article' : 'website';
const alternateLang = lang === 'ja' ? 'en' : 'ja';
const alternateUrl = alternateHref
  ? new URL(alternateHref, Astro.site ?? Astro.url.origin)
  : undefined;
const rssUrl = new URL(lang === 'en' ? '/en/rss.xml' : '/rss.xml', Astro.site ?? Astro.url.origin);

const author = {
  '@type': 'Person',
  name: site.author || 'mantaroh',
  url: 'https://mantaroh.org'
};

const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: finalDescription,
      url: canonicalUrl.href,
      mainEntityOfPage: canonicalUrl.href,
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      inLanguage: lang === 'en' ? 'en' : 'ja',
      author,
      keywords: tags
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.title,
      description: finalDescription,
      url: canonicalUrl.href,
      inLanguage: lang === 'en' ? 'en' : 'ja',
      author
    };

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={site.author || 'mantaroh'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={rssUrl} />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
        <link rel="alternate" hreflang="x-default" href={lang === 'ja' ? canonicalUrl : alternateUrl} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {alternateUrl && (
      <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />
    )}
    <meta name="twitter:card" content="summary" />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <script type="application/ld+json" set:html={structuredDataJson}></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <div class="container header-inner">
          <a class="site-title" href={lang === 'en' ? '/en/' : '/'}>{site.title}</a>
          <nav class="site-nav" aria-label="Primary">
            <a href={lang === 'en' ? '/en/' : '/'}>Home</a>
            <a href={lang === 'en' ? '/' : '/en/'}>{lang === 'en' ? '日本語' : 'English'}</a>
            <a href="https://mantaroh.org">mantaroh.org</a>
          </nav>
        </div>
      </header>

      <main class="container"><slot /></main>

      <footer class="site-footer">
        <div class="container footer-inner">
          <span>© {new Date().getFullYear()} {site.author || 'mantaroh'}</span>
          <span class="footer-mark">human-written / machine-assisted</span>
        </div>
      </footer>
    </div>
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"e954d34b93554f938fa9ad778f8d33ad"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
