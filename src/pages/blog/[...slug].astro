---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const englishPosts = await getCollection('blogEn', ({ data }) => !data.draft);
  const englishIds = new Set(englishPosts.map((post) => post.id));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      alternateHref: englishIds.has(post.id) ? `/en/blog/${post.id}/` : undefined
    }
  }));
}

const { post, alternateHref } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
  lang="ja"
  alternateHref={alternateHref}
>
  <article class="article">
    <header class="article-header">
      <a class="back-link" href="/">← All notes</a>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('ja-JP', {
          year: 'numeric', month: '2-digit', day: '2-digit'
        })}
      </time>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-description">{post.data.description}</p>}
      {alternateHref && <p><a href={alternateHref}>Read in English →</a></p>}
      {post.data.tags.length > 0 && (
        <div class="tags" aria-label="Tags">
          {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="article-body">
      <Content />
    </div>

    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">Comments</h2>
      <script
        src="https://giscus.app/client.js"
        data-repo="mantaroh/blog"
        data-repo-id="R_kgDOIaAWqQ"
        data-category="General"
        data-category-id="DIC_kwDOIaAWqc4DFXdS"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="ja"
        crossorigin="anonymous"
        async
      ></script>
    </section>
  </article>
</BaseLayout>
